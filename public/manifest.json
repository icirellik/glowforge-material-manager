{
  "short_name": "Glowforge Materials",
  "name": "Glowforge Material Manager",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "description": "Browser extension that allows users to save and modify their own materials for use in the Glowforge web interface.",
  "default_locale": "en",
  "action": {
    "default_popup": "index.html",
    "default_title": "Glowforge Material Manager"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://app.glowforge.com/*",
    "https://storage.googleapis.com/gf-app-imgl/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://app.glowforge.com/*"
      ],
      "js": [ "bridge.js" ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://app.glowforge.com/*"
      ],
      "js": [ "content.js" ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "custom-material.png"
      ],
      "matches": [
        "*://app.glowforge.com/*"
      ]
    }
  ],
  "key": "",
  "version": "0.4.10"
}
