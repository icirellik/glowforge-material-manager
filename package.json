{
  "name": "glowforge-material-editor",
  "version": "0.4.10",
  "private": true,
  "dependencies": {
    "@zxing/library": "0.15.1",
    "jsqr": "1.2.0",
    "pako": "1.0.6",
    "qr-scanner": "1.1.1",
    "qrcode": "1.4.4",
    "react": "16.8.6",
    "react-dom": "16.8.6",
    "uuid": "8.3.2"
  },
  "scripts": {
    "clean": "rm -rf build",
    "build": "yarn type-check && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src/",
    "release-test": "yarn build && mkdir -p releases && cd build && sed -i '/\"key\"/d' manifest.json && sed -i 's/Glowforge Material Manager/Glowforge Material Manager Test/g' manifest.json && zip -r glowforge-material-manager-test.zip . && mv -f *.zip ../releases && cd ..",
    "release": "yarn build && mkdir -p releases && cd build && sed -i '/\"key\"/d' manifest.json && zip -r glowforge-material-manager.zip . && mv -f *.zip ../releases && cd ..",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@types/pako": "1.0.1",
    "@types/qrcode": "1.3.5",
    "@types/react": "16.8.16",
    "@types/react-dom": "16.8.4",
    "@types/uuid": "8.3.0",
    "@typescript-eslint/eslint-plugin": "4.14.1",
    "@typescript-eslint/parser": "4.14.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "canvas": "3.2.3",
    "eslint": "7.18.0",
    "eslint-config-airbnb": "18.2.1",
    "eslint-plugin-import": "2.22.1",
    "eslint-plugin-jsx-a11y": "6.4.1",
    "eslint-plugin-react": "7.22.0",
    "eslint-plugin-react-hooks": "4.2.0",
    "jsdom": "30.1.2",
    "ts-node": "9.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
