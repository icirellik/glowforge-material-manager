{
  "name": "glowforge-material-editor",
  "version": "0.4.10",
  "private": true,
  "dependencies": {
    "pako": "1.0.6",
    "react": "16.8.6",
    "react-dom": "16.8.6",
    "uuid": "8.3.2"
  },
  "scripts": {
    "clean": "rm -rf build",
    "build": "npm run type-check && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "release-test": "npm run build && mkdir -p releases && cd build && sed -i '/\"key\"/d' manifest.json && sed -i 's/Glowforge Material Manager/Glowforge Material Manager Test/g' manifest.json && zip -r glowforge-material-manager-test.zip . && mv -f *.zip ../releases && cd ..",
    "release": "npm run build && mkdir -p releases && cd build && sed -i '/\"key\"/d' manifest.json && zip -r glowforge-material-manager.zip . && mv -f *.zip ../releases && cd ..",
    "type-check": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "@types/pako": "1.0.1",
    "@types/react": "16.8.16",
    "@types/react-dom": "16.8.4",
    "@types/uuid": "8.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "canvas": "3.2.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "ts-node": "9.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "fsevents": false
  }
}
